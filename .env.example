# Copy to .env and fill in. Only the first three are required.

# Where Watched can reach Jellyfin (from inside the container), including any base path.
JELLYFIN_URL=http://jellyfin:8096
# Jellyfin Dashboard → API Keys → +
JELLYFIN_API_KEY=
# The Jellyfin username whose watch history to show.
JELLYFIN_USER=

# Libraries to leave out, comma-separated (names as shown in Jellyfin).
# EXCLUDE_LIBRARIES=Adult,Home Videos

# Use your own Trakt app for "Import from Trakt", or "off" to remove the option.
# TRAKT_CLIENT_ID=

# REFRESH_MINUTES=30
# PORT=8080
# TZ=Europe/London
